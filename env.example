# Archivo de ejemplo de variables de entorno
# Copia este archivo como .env.local y completa los valores

# MongoDB Connection String
# Obtén tu connection string desde MongoDB Atlas: https://cloud.mongodb.com/
# Formato: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=

# Base URL de la aplicación (para producción cambiar a tu dominio)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
